class Solution(object):
    def countNegatives(self, a):
        """
        :type grid: List[List[int]]
        :rtype: int
        """
        
        count=0
        for i in range(len(a)-1+1):
            for j in range(0,len(a[i])):
                if a[i][j]<0:
                    count+=1

        return count
